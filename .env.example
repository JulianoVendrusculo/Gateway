# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# "true" quando atrás de load balancer / reverse proxy (necessário p/ IP real e rate limit)
TRUST_PROXY=false
# Origens CORS permitidas (CSV). Vazio = CORS desabilitado (API server-to-server).
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://gateway:gateway@localhost:5432/payment_gateway?schema=public

# ---------------------------------------------------------------------------
# Criptografia (gere valores reais com: npm run keys:generate)
# ENCRYPTION_KEYS: chaveiro "id:base64(32 bytes)" separado por vírgula -> permite rotação.
# ENCRYPTION_ACTIVE_KEY_ID: chave usada para NOVAS cifragens; as demais só decifram.
# Em produção, prefira injetar via Secret Manager / KMS (nunca commitar).
# ---------------------------------------------------------------------------
ENCRYPTION_KEYS=k1:REPLACE_WITH_BASE64_32_BYTES
ENCRYPTION_ACTIVE_KEY_ID=k1
# HMAC para blind index de documentos (CPF/CNPJ) — permite busca sem armazenar em claro
BLIND_INDEX_KEY=REPLACE_WITH_BASE64_32_BYTES
# Pepper HMAC para hash das API keys dos lojistas
API_KEY_PEPPER=REPLACE_WITH_BASE64_32_BYTES
# Token das rotas administrativas (/v1/admin/*). Mínimo 32 caracteres.
ADMIN_API_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN

# ---------------------------------------------------------------------------
# Webhooks bancários
# ---------------------------------------------------------------------------
# Segredo compartilhado (enviado em ?token=, header x-webhook-token ou /t/:token)
WEBHOOK_SECRET_BB=REPLACE_WITH_LONG_RANDOM_TOKEN
WEBHOOK_SECRET_CAIXA=REPLACE_WITH_LONG_RANDOM_TOKEN
# Exige que o proxy TLS (nginx/ALB/Envoy) tenha validado o certificado cliente do banco
WEBHOOK_REQUIRE_MTLS=false
WEBHOOK_MTLS_VERIFY_HEADER=x-ssl-client-verify
WEBHOOK_MTLS_SUBJECT_HEADER=x-ssl-client-s-dn
# Trechos aceitos no Subject DN do certificado do banco (CSV, opcional)
WEBHOOK_BB_ALLOWED_SUBJECTS=
WEBHOOK_CAIXA_ALLOWED_SUBJECTS=
# Allowlist de IPs/CIDRs de origem (CSV, opcional)
WEBHOOK_BB_ALLOWED_IPS=
WEBHOOK_CAIXA_ALLOWED_IPS=
# Nunca confiar apenas no payload: reconsulta o banco antes de marcar como pago
WEBHOOK_CONFIRM_WITH_PROVIDER=true

# ---------------------------------------------------------------------------
# Integrações bancárias
# ---------------------------------------------------------------------------
BANK_HTTP_TIMEOUT_MS=20000
BANK_HTTP_CONNECT_TIMEOUT_MS=5000
# Hosts aceitos em overrides de URL nos convênios (anti-SSRF). Sufixos, CSV.
BANK_URL_ALLOWED_HOSTS=.bb.com.br,.caixa.gov.br

# ---------------------------------------------------------------------------
# Idempotência / Reconciliação / Rate limit
# ---------------------------------------------------------------------------
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_LOCK_TIMEOUT_SECONDS=60
RECONCILIATION_ENABLED=true
RECONCILIATION_INTERVAL_MS=300000
RECONCILIATION_BATCH_SIZE=50
RECONCILIATION_MIN_RESYNC_SECONDS=600
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
